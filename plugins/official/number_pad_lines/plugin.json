{
  "name": "number_pad_lines",
  "version": "1.0.0",
  "plugin_api_version": "2.0",
  "description": "Chiffrement/déchiffrement Number Pad Lines : trace des lignes entre les touches d'un clavier téléphonique (1-9,0) pour former la silhouette d'une lettre ou d'un chiffre (compatible cachesleuth.com/tools/numberpadlines).",
  "author": "MysterAI",
  "plugin_type": "python",
  "entry_point": "main.py",
  "dependencies": [],
  "categories": ["SymbolsDecryption", "Substitution"],
  "kinds": ["code"],
  "brute_force": false,
  "enable_scoring": true,
  "accept_accents": false,
  "heavy_cpu": false,
  "needs_network": false,
  "needs_filesystem": false,
  "timeout_seconds": 30,
  "capabilities": {
    "analyze": true,
    "decode": true,
    "encode": true
  },
  "defaults": {
    "include_in_analysis": true,
    "include_in_decode": true
  },
  "input_types": {
    "text": {
      "type": "string",
      "label": "Texte à traiter",
      "placeholder": "Texte en clair, ou chemins numériques séparés par des espaces (ex: 7295 3145479 71397)",
      "required": true
    },
    "mode": {
      "type": "select",
      "label": "Mode",
      "options": ["decode", "encode", "detect"],
      "default": "decode",
      "required": true
    }
  },
  "output_types": {
    "text_output": {
      "type": "string",
      "label": "Texte transformé"
    }
  },
  "text_handling": {
    "fields": ["text"],
    "allowed_ranges": ["0030-0039", "0041-005A"],
    "allowed_characters": " \t\r\n/",
    "unknown_char_policy": "warn_keep",
    "normalize": {
      "remove_diacritics": true,
      "case": "upper",
      "map_characters": {}
    }
  },
  "metasolver": {
    "eligible": true,
    "input_charset": "digits",
    "tags": ["substitution", "no_key", "geocaching", "grouped_input"],
    "priority": 45,
    "family": "keypad_lines",
    "preferred_when": ["digits_only", "grouped_input"],
    "requires_key": false,
    "supports_grouped_input": true
  }
}
