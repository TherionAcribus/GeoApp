{
  "name": "malespin",
  "version": "1.0.0",
  "plugin_api_version": "2.0",
  "description": "Argot Malespin : substitution reciproque A/E, B/T, F/G, I/O et M/P.",
  "author": "MysterAI Team",
  "plugin_type": "python",
  "entry_point": "main.py",
  "dependencies": [],
  "categories": ["AlphabetsDecryption", "Language"],
  "kinds": ["code", "text"],
  "brute_force": false,
  "enable_scoring": true,
  "accept_accents": true,
  "heavy_cpu": false,
  "needs_network": false,
  "needs_filesystem": false,
  "timeout_seconds": 30,
  "capabilities": {
    "analyze": true,
    "decode": true,
    "encode": true
  },
  "defaults": {
    "include_in_analysis": true,
    "include_in_decode": true
  },
  "input_types": {
    "text": {
      "type": "textarea",
      "label": "Texte a traiter",
      "placeholder": "Entrez un texte clair ou en Malespin...",
      "required": true
    },
    "mode": {
      "type": "select",
      "label": "Mode",
      "options": ["decode", "encode", "detect"],
      "default": "decode",
      "required": true
    },
    "strict": {
      "type": "select",
      "label": "Mode de traitement",
      "options": ["strict", "smooth"],
      "default": "smooth"
    },
    "embedded": {
      "type": "boolean",
      "label": "Texte integre",
      "default": false
    },
    "allowed_chars": {
      "type": "string",
      "label": "Caracteres de separation autorises",
      "placeholder": "Ex: espace, ponctuation...",
      "default": " \t\r\n.:;,_-'\"!?¿¡"
    },
    "enable_scoring": {
      "type": "boolean",
      "label": "Scoring (legacy)",
      "default": true,
      "hidden": true
    }
  },
  "output_types": {
    "text_output": {
      "type": "string",
      "label": "Texte transforme"
    }
  },
  "text_handling": {
    "fields": ["text"],
    "allowed_ranges": ["0041-005A", "0061-007A"],
    "allowed_characters": " \t\r\n.:;,_-'\"!?¿¡",
    "unknown_char_policy": "warn_keep",
    "normalize": {
      "remove_diacritics": true,
      "case": "preserve",
      "map_characters": {}
    }
  },
  "metasolver": {
    "eligible": true,
    "input_charset": "letters",
    "tags": ["substitution", "no_key"],
    "priority": 45,
    "family": "language_substitution",
    "preferred_when": ["letters_only", "spanish_like"]
  }
}
