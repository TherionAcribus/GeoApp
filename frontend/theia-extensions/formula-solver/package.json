{
  "name": "@mysterai/theia-formula-solver",
  "version": "1.0.0",
  "description": "Formula Solver Extension for Mystery Geocaches in Theia IDE",
  "keywords": [
    "theia-extension",
    "formula-solver",
    "geocaching",
    "mysterai",
    "gps-coordinates"
  ],
  "license": "MIT",
  "main": "lib/browser/formula-solver-frontend-module.js",
  "typings": "lib/browser/formula-solver-frontend-module.d.ts",
  "dependencies": {
    "axios": "^1.6.0"
  },
  "scripts": {
    "prepare": "yarn run clean && yarn run build",
    "clean": "rimraf lib",
    "build": "tsc && yarn run copy:assets",
    "copy:assets": "node -e \"require('fs-extra').copySync('src/browser/style', 'lib/browser/style')\"",
    "watch": "tsc -w",
    "test": "node ../../node_modules/ts-node/dist/bin.js src/browser/tests/ai-per-question-answering.test.ts && node ../../node_modules/ts-node/dist/bin.js src/browser/tests/formula-solver-local-model.test.ts && node ../../node_modules/ts-node/dist/bin.js src/browser/tests/formula-solver-service.test.ts",
    "update:theia": "ts-node ../../scripts/update-theia-version.ts",
    "update:next": "ts-node ../../scripts/update-theia-version.ts next"
  },
  "devDependencies": {
    "rimraf": "^5.0.0",
    "typescript": "~5.9.3",
    "@theia/core": "1.76.0",
    "@theia/filesystem": "1.76.0",
    "@theia/workspace": "1.76.0"
  },
  "peerDependencies": {
    "@theia/core": "1.76.0",
    "theia-ide-zones-ext": "1.76.200"
  },
  "theiaExtensions": [
    {
      "frontend": "lib/browser/formula-solver-frontend-module"
    }
  ]
}
