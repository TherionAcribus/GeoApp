{
  "name": "@mysterai/theia-plugins",
  "version": "1.0.0",
  "description": "MysterAI Plugins Extension for Theia IDE",
  "keywords": [
    "theia-extension",
    "plugins",
    "geocaching",
    "mysterai"
  ],
  "license": "MIT",
  "main": "lib/browser/plugins-frontend-module.js",
  "typings": "lib/browser/plugins-frontend-module.d.ts",
  "dependencies": {
    "@types/ol": "^7.0.0",
    "axios": "^1.6.0",
    "ol": "^10.7.0"
  },
  "scripts": {
    "prepare": "yarn run clean && yarn run build",
    "clean": "rimraf lib",
    "build": "tsc && yarn run copy:assets",
    "test:geoapp": "node ../../node_modules/ts-node/dist/bin.js src/browser/tests/plugin-executor-geoapp-shared.test.ts",
    "test:ai-scorer": "node ../../node_modules/ts-node/dist/bin.js src/browser/tests/ai-scorer-model-resolver.test.ts",
    "copy:assets": "node -e \"require('fs-extra').copySync('src/browser/style', 'lib/browser/style')\"",
    "watch": "tsc -w",
    "update:theia": "ts-node ../../scripts/update-theia-version.ts",
    "update:next": "ts-node ../../scripts/update-theia-version.ts next"
  },
  "devDependencies": {
    "@theia/ai-core": "1.76.0",
    "@theia/core": "1.76.0",
    "@theia/filesystem": "1.76.0",
    "@theia/workspace": "1.76.0",
    "@types/react": "^19.0.0",
    "fs-extra": "^11.0.0",
    "rimraf": "^5.0.0",
    "typescript": "~5.9.3"
  },
  "peerDependencies": {
    "@theia/ai-core": "1.76.0",
    "@theia/core": "1.76.0",
    "@theia/filesystem": "1.76.0",
    "@theia/workspace": "1.76.0"
  },
  "theiaExtensions": [
    {
      "frontend": "lib/browser/plugins-frontend-module"
    }
  ]
}
