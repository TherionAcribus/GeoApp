{
  "private": true,
  "name": "theia-ide-earthcoach-ext",
  "version": "1.76.200",
  "description": "GeoApp EarthCoach - assistant IA EarthCache pour Theia",
  "keywords": [
    "theia-extension",
    "geocaching",
    "earthcache",
    "ai"
  ],
  "license": "MIT",
  "files": [
    "lib",
    "src"
  ],
  "main": "lib/browser/earthcoach-frontend-module.js",
  "typings": "lib/browser/earthcoach-frontend-module.d.ts",
  "dependencies": {
    "@theia/core": "1.76.0",
    "@theia/ai-chat": "1.76.0",
    "@theia/ai-core": "1.76.0",
    "theia-ide-zones-ext": "1.76.200"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "rimraf": "^2.7.1",
    "typescript": "~5.9.3"
  },
  "scripts": {
    "clean": "rimraf lib *.tsbuildinfo",
    "build": "tsc -b",
    "test:earthcoach": "node ../../node_modules/ts-node/dist/bin.js src/browser/tests/earthcoach-prompt-builder.test.ts",
    "watch": "rimraf lib *.tsbuildinfo && tsc -w",
    "update:theia": "ts-node ../../scripts/update-theia-version.ts",
    "update:next": "ts-node ../../scripts/update-theia-version.ts next"
  },
  "theiaExtensions": [
    {
      "frontend": "lib/browser/earthcoach-frontend-module"
    }
  ]
}
