{
  "name": "@mysterai/theia-calculator",
  "version": "1.0.0",
  "description": "MysterAI Calculator Extension for Theia IDE",
  "keywords": [
    "theia-extension",
    "calculator",
    "geocaching",
    "mysterai"
  ],
  "license": "MIT",
  "main": "lib/browser/calculator-frontend-module.js",
  "typings": "lib/browser/calculator-frontend-module.d.ts",
  "dependencies": {
    "mathjs": "^12.0.0"
  },
  "scripts": {
    "clean": "rimraf lib",
    "build": "tsc && yarn run copy:assets",
    "copy:assets": "node -e \"require('fs-extra').copySync('src/browser/style', 'lib/browser/style')\"",
    "watch": "tsc -w",
    "update:theia": "ts-node ../../scripts/update-theia-version.ts",
    "update:next": "ts-node ../../scripts/update-theia-version.ts next"
  },
  "devDependencies": {
    "rimraf": "^5.0.0",
    "typescript": "~5.9.3",
    "fs-extra": "^11.0.0",
    "@types/react": "^19.0.0",
    "@theia/core": "1.76.0",
    "@theia/ai-core": "1.76.0"
  },
  "peerDependencies": {
    "@theia/core": "1.76.0",
    "@theia/ai-core": "1.76.0"
  },
  "theiaExtensions": [
    {
      "frontend": "lib/browser/calculator-frontend-module"
    }
  ]
}
